# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Local services (this machine) ────────────────────────────────────────────
# STT: run `uv run python stt_server.py` (listens on :8766)
STT_SERVER_URL=http://localhost:8766
# LLM: local Ollama (`ollama serve`)
HUGIN_BASE_URL=http://localhost:11434
# Live graph extraction model (any model from `ollama list`). Default: gemma4:e4b
#   lighter: llama3.2:1b   heavier/better: gemma4:12b-mlx, qwen3-coder:30b
OLLAMA_MODEL=gemma4:e4b
# Recaps / synthesis / transcript cleanup (blank = same as OLLAMA_MODEL)
OLLAMA_RECAP_MODEL=
# Context window (tokens). Larger = longer recaps, more RAM.
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_CONCURRENCY=1
# Local STT server (stt_server.py)
#   STT_ENGINE: auto | mlx | faster-whisper
#   STT_MODEL:  blank = engine default (mlx: mlx-community/whisper-large-v3-turbo,
#               faster-whisper: small). Lighter: mlx-community/whisper-small-mlx, base
STT_ENGINE=auto
STT_MODEL=
# Only needed if pointing the URLs above at a Cloudflare-Access-protected tunnel:
# STT_CF_ID=
# STT_CF_SECRET=
# HUGIN_CF_ID=
# HUGIN_CF_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Local: leave unset (defaults to livemind.db in working directory)
# Docker / Azure: set to /data/livemind.db (mount a volume/file share at /data)
DB_PATH=

# ── Azure deployment ──────────────────────────────────────────────────────────
AZURE_RESOURCE_GROUP=rg-invent-global-ai
AZURE_LOCATION=uknorth
ACR_NAME=inventaiacr
CONTAINER_APP_ENV=livemind-env
CONTAINER_APP_NAME=livemind
STORAGE_ACCOUNT_NAME=livemindstorage
STORAGE_SHARE_NAME=live-mind
